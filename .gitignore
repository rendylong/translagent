# 密钥——绝不入库
env.rtf

# 用户会议资料与音频文件(所有音频、文稿不出本机)
会议/
*.m4a
*.wav
*.mp3
*.aac
*.aif
*.aiff
*.flac

# 大二进制模型与任务数据(脚本与指标类 bench 记录入库)
transcriber/models/**
!transcriber/models/bench/
!transcriber/models/bench/*.py
!transcriber/models/bench/*.json
# stream bench 输出内嵌真实会议转录文本,不出本机
transcriber/models/bench/stream_*.json
transcriber/jobs/
transcriber/live/

# 声纹库(192 维质心为生物特征数据,不出本机)
transcriber/speakers/

